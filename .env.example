# ==========================================
# Urban Escape Property & House Management System - Environment Configuration
# Copy to .env and adjust. Never commit the real .env file.
# ==========================================

APP_NAME="Urban Escape"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Property_And_House_Management_System

# Database Configuration (XAMPP MySQL/MariaDB defaults)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nairobi_property_db
DB_USER=root
DB_PASS=

# Payments are recorded by staff; the system does not connect to M-Pesa or any other
# payment service (project scope), so no payment gateway keys are needed.
